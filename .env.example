# Runtime
APP_NAME=Tutova API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Database and security
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=tutova_refresh
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://your-frontend-domain.example

# Paystack
PAYMENT_PROVIDER=PAYSTACK
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_SECRET
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_PAYSTACK_PUBLIC_KEY
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://your-frontend-domain.example/payment/callback
PAYSTACK_CHANNELS=card,bank_transfer,ussd
PAYSTACK_TIMEOUT_SECONDS=15

# Frontend links used by transactional emails
FRONTEND_BASE_URL=https://your-frontend-domain.example

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_PICTURE_MAX_SIZE=5242880
CLOUDINARY_IDENTITY_DOCUMENT_MAX_SIZE=10485760
CLOUDINARY_IDENTITY_DOCUMENT_URL_TTL_SECONDS=300

# Password reset and database pool
PASSWORD_RESET_TOKEN_MINUTES=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
